{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowdoro",
  "version": "2.0.0",
  "identifier": "com.flowdoro.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Flowdoro",
        "width": 900,
        "height": 580,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://noembed.com https://api.github.com https://github.com https://objects.githubusercontent.com; media-src 'self' asset: http://asset.localhost blob:; img-src 'self' asset: http://asset.localhost blob: data: https://i.ytimg.com https://img.youtube.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/videos/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NjI2QUE5M0IyN0NENEUKUldST3pTYzdxV3BpeEVwZGY4VXAwcUROV2F6TXJJNXdoOVNjeWRVRy9GRSt6eWpqOStnbVQ0VU8K",
      "endpoints": [
        "https://github.com/Keemoz05/Flowdoro/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
